<div class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <div class="auth-logo">JB</div>
      <h1><%= t('auth.sign_up_title') %></h1>
      <p><%= t('auth.sign_up_subtitle') %></p>
    </div>

    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
      <%= f.error_notification %>

      <div class="form-group">
        <%= f.label :email %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: t('auth.email_placeholder') %>
      </div>

      <div class="form-group">
        <%= f.label :password %>
        <%= f.password_field :password, autocomplete: "new-password", placeholder: t('auth.password_create_placeholder') %>
        <% if @minimum_password_length %>
          <p class="hint"><%= t('auth.password_min_chars', count: @minimum_password_length) %></p>
        <% end %>
      </div>

      <div class="form-group">
        <%= f.label :password_confirmation %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: t('auth.password_confirm_placeholder') %>
      </div>

      <%= f.submit t('auth.sign_up_submit'), class: "btn-submit" %>
    <% end %>

    <div class="auth-footer">
      <p><%= t('auth.have_account_prompt') %> <%= link_to t('auth.sign_in_link'), new_session_path(resource_name) %></p>
    </div>
  </div>
</div>
