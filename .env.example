# JapanBuddy AI — example environment file
# Copy to .env and fill in your real values:
#   cp .env.example .env

# ---- OpenAI ----
# Required: OpenAI API key used for chat completions and embeddings.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ---- Database ----
# Optional. Defaults to local socket connection in config/database.yml.
# DATABASE_URL=postgres://localhost/japanbuddy_development

# ---- Production ----
# Canonical host the app is served on (no scheme). Used for mailer URLs
# and DNS-rebinding protection.
# APP_HOST=japanbuddy.ai

# Comma-separated extra hosts to allow (e.g. preview deploys).
# EXTRA_HOSTS=staging.japanbuddy.ai,preview.japanbuddy.ai

# Whether the app is behind an SSL-terminating proxy (Heroku, Fly, Cloudflare).
# ASSUME_SSL=true

# From address used by Devise mails (password reset etc).
# DEVISE_MAILER_SENDER=no-reply@japanbuddy.ai

# ---- Development helpers ----
# Set to 1 to stub all OpenAI calls (used in CI and offline development).
# STUB_OPENAI=0

# Maximum seconds to wait on an OpenAI HTTP request before raising
# Faraday::TimeoutError. The AiAnswerService catches that and returns a
# localized "I couldn't reach the answer service" message instead of hanging.
# Keep this below your platform's edge timeout (Heroku H12 = 30s).
# OPENAI_REQUEST_TIMEOUT=25

# Maximum size (bytes) for an uploaded Document file. Default 10 MB.
# MAX_DOCUMENT_BYTES=10485760
