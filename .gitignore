# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore all environment files, but keep templates/examples.
.env*
!.env.example
!.env*.example
!.env*.erb

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore Rails credentials master/per-env keys.
/config/master.key
/config/credentials/*.key

# Ignore compiled assets.
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep

# Ignore JS dependencies (in case bundling is added).
/node_modules/
/yarn-error.log
/yarn-debug.log*
npm-debug.log*

# Test coverage reports.
/coverage/
/test/coverage/

# Ruby tooling caches & histories.
.byebug_history
.rspec_status
.ruby-lsp/

# OS & editor cruft.
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.iml

# Local-only override files.
*.local
*.local.yml

# Claude Code & MCP session state.
/.claude/
/.playwright-mcp/
